# Copie para a Vercel em Settings > Environment Variables (não coloque senhas no código).

# Loja
LOJA_CEP_ORIGEM=20040-020            # CEP de onde os pedidos saem (TROCAR)
LOJA_EMAIL_CONTATO=contato@azconfort.com.br

# Logística
LOGISTICA_TRANSPORTADORAS=tabela     # ex.: tabela,melhorenvio
LOGISTICA_DIAS_MANUSEIO=1            # dias para separar e postar
LOGISTICA_TIMEOUT_MS=8000
# LOGISTICA_TABELA_JSON={...}        # tabela própria real (formato em api/_lib/logistica/tabela-padrao.js)

# Melhor Envio (Correios, Jadlog, Loggi, J&T, Azul Cargo...)
MELHORENVIO_TOKEN=
MELHORENVIO_AMBIENTE=sandbox         # sandbox | producao
MELHORENVIO_SERVICOS=                # opcional: ids separados por vírgula

# Pagamento
PAGAMENTO_PROVEDOR=simulacao         # simulacao | blue
BLUE_API_URL=
BLUE_CLIENT_ID=
BLUE_CLIENT_SECRET=
BLUE_WEBHOOK_SEGREDO=
