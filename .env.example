# Copie para .env.local e preencha. NUNCA versione .env.local.
# Variáveis NEXT_PUBLIC_* vão para o navegador: nunca coloque segredos nelas.

# --- Site e marca -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Cuxões

# Fonte do catálogo público: "supabase" ou "demo".
# Sem valor: usa Supabase quando configurado; senão, modo demonstração.
CATALOG_SOURCE=

# --- Supabase ---------------------------------------------------------------
# URL e chave pública (anon/publishable). O RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: scripts locais (ex.: criar administrador) e a IA na nuvem do
# estúdio (pega tarefas da fila e grava os resultados). Na Vercel: variável
# Sensitive, só do servidor. O resto do site usa a sessão do usuário (RLS).
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso ao painel por PIN (somente servidor; NUNCA NEXT_PUBLIC_) ---------
# Ao acertar o PIN, o servidor entra nesta conta da equipe (crie com
# `npm run admin:create`). Desligado se faltar qualquer uma. Ver docs/PAINEL.md.
# 1234 é só para demonstração: use um PIN longo antes de vender.
ADMIN_PIN=
ADMIN_PIN_EMAIL=
ADMIN_PIN_PASSWORD=

# --- Estúdio de IA (somente servidor e processador; NUNCA NEXT_PUBLIC_) ------
# Com estas chaves na Vercel, tudo roda na nuvem (sem computador ligado).
# Ver docs/ESTUDIO-IA.md. AI_CLOUD=0 desliga a nuvem (só processador local).
AI_CLOUD=
# Limpeza de fundo pela fal.ai (https://fal.ai/dashboard/keys). Opcional: sem
# ela, a limpeza é feita pelo ChatGPT (OPENAI_API_KEY).
FAL_KEY=
# Limpeza do fundo (sem FAL_KEY), fotos de catálogo e textos da loja
OPENAI_API_KEY=
# Qualidade da limpeza com o ChatGPT: medium (padrão, ~20 s) ou high (~33 s)
OPENAI_CLEANUP_QUALITY=
# Estilo das fotos de catálogo: creme (padrão), neutro ou ambiente-vazio
CATALOG_STYLE=
# Opcionais (padrões: gpt-image-2.5-sunburst e gpt-5.1)
OPENAI_IMAGE_MODEL=
OPENAI_TEXT_MODEL=
# 3D pela API do Tripo (https://platform.tripo3d.ai)
TRIPO_API_KEY=
TRIPO_MODEL=
# 3D local (TripoSR), só depois de instalado: AI_3D_ENGINE=triposr
AI_3D_ENGINE=

# --- Assistente de vendas (somente servidor; NUNCA NEXT_PUBLIC_) -------------
# Com a chave, o botão "Ajuda" aparece na loja. Ver docs/ASSISTENTE.md.
ANTHROPIC_API_KEY=
# Opcionais: modelo (padrão claude-haiku-5-5) e desligar sem tirar a chave (false)
ASSISTANT_MODEL=
ASSISTANT_ENABLED=

# --- Integrações futuras (não configure até escolher o provedor) ------------
THREE_D_MODEL_PROVIDER=
THREE_D_MODEL_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
